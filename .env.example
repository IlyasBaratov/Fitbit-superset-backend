# Fitbit / Google Health API
FITBIT_LOG_FILE_PATH=/path/to/fitbit.log
TOKEN_FILE_PATH=/path/to/token_store.json
HEALTH_API_PROVIDER=fitbit

# Fitbit OAuth
CLIENT_ID=your_application_client_ID
CLIENT_SECRET=your_application_client_secret

# Google Health API
GOOGLE_CLIENT_ID=your_application_client_ID
GOOGLE_CLIENT_SECRET=your_application_client_secret
GOOGLE_HEALTH_BASE_URL=https://health.googleapis.com
GOOGLE_HEALTH_API_VERSION=v4
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# Google Calendar sync (read-only, optional)
CALENDAR_SYNC_ENABLED=false
# Comma-separated calendar ids; defaults to "primary".
CALENDAR_IDS=primary
# Fall back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET when empty.
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_FILE_PATH=./tokens/google_calendar.token
CALENDAR_SYNC_DAYS_BACK=7
CALENDAR_SYNC_DAYS_AHEAD=1
# Redirect URI of GET /api/calendar/callback; register it on the OAuth client.
CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar/callback
# Send recurring-meeting titles to Gemini; false replaces them with series-1, series-2, ...
CALENDAR_AI_INCLUDE_TITLES=true
# uid the API container runs as; must equal the collector's appuser uid
# (docker compose exec fitbit-fetch-data id -u) so both read ./tokens.
API_UID=10001

# InfluxDB (1.x)
INFLUXDB_VERSION=1
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=your_influxdb_username
INFLUXDB_PASSWORD=your_influxdb_password
INFLUXDB_DATABASE=your_influxdb_database_name

# InfluxDB (2.x)
INFLUXDB_BUCKET=your_bucket_name_here
INFLUXDB_ORG=your_org_here
INFLUXDB_TOKEN=your_token_here
INFLUXDB_URL=http://localhost:8087

# InfluxDB (3.x)
# When INFLUXDB_VERSION=3, use INFLUXDB_HOST=localhost and INFLUXDB_PORT=8181.
INFLUXDB_V3_ACCESS_TOKEN=

# Googe Calendar token
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_SYNC_ENABLED=true
CALENDAR_IDS=primary


# Device metadata
DEVICENAME=Charge5
USER_ID=user_001
DEVICE_ID=fitbit_air_001
DEVICE_METADATA_STATE_PATH=./tokens/device_metadata_state.json
LOCAL_TIMEZONE=Automatic

# Date range settings
MANUAL_START_DATE=
MANUAL_END_DATE=
AUTO_DATE_RANGE=true

# Runtime options
DRY_RUN_MODE=false
LOG_LEVEL=DEBUG
REQUEST_MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=30

# Optional: if you want to force a specific date range, set both values in YYYY-MM-DD format
# MANUAL_START_DATE=2024-01-01
# MANUAL_END_DATE=2024-01-31

# AI REST API (independent of the collector)
GEMINI_API_KEY=
MODEL_NAME=
# GEMINI_MODEL is accepted when MODEL_NAME is empty.
GEMINI_MODEL=
# Generate a random token of at least 32 characters; do not reuse the Gemini key.
AI_API_TOKEN=
AI_DEFAULT_ANALYSIS_DAYS=7
AI_MAX_ANALYSIS_DAYS=90
GEMINI_TIMEOUT_MS=45000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=250
GEMINI_RETRY_MAX_BACKOFF_MS=2000
GEMINI_RETRY_JITTER_MS=200
GEMINI_RETRY_MAX_ELAPSED_MS=55000
# Optional: fallback model used only after transient failures on MODEL_NAME.
GEMINI_FALLBACK_MODEL=
TZ=America/Los_Angeles
